@router.get("/gpu", response_model=GPUStatusResponse, tags=["System"])
async def gpu_status():
    """Get current GPU status and memory usage."""
    from backend.utils.gpu import get_gpu_stats

    stats = get_gpu_stats()
    return GPUStatusResponse(
        is_available=stats.is_available,
        device_name=stats.device_name,
        total_memory_gb=stats.total_memory_gb,
        allocated_memory_gb=stats.allocated_memory_gb,
        free_memory_gb=stats.free_memory_gb,
        utilization_percent=stats.utilization_percent,
        cuda_version=stats.cuda_version,
    )


