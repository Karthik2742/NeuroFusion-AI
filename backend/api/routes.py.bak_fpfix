@router.get("/models/enhancement", tags=["Models"])
async def list_enhancement_models():
    """List available enhancement models."""
    return {"models": _ENHANCEMENT_MODELS_CACHE}


@router.get("/files", tags=["Files"])
async def list_files():
    """List all uploaded and processed files."""
    load_registry()
    files = []
    for file_id, info in file_registry.items():
        if Path(info.get("filepath", "")).exists():
            files.append({
                "file_id": file_id,
                "filename": info.get("filename", "unknown"),
                "shape": info.get("shape", []),
                "modality": info.get("modality", "Unknown"),
                "mri_type": info.get("mri_type", "unknown"),
            })
    return {"files": files}


@router.get("/dataset/tree", tags=["Analysis"])
async def get_dataset_tree():
    """Get structured tree of dataset directory with Brain MRI categories."""
    dataset_root = Path(config.get("paths.dataset_dir", "./dataset"))
    structure = {
        "brain": {"normal": [], "tumor": [], "stroke": []},
    }
    
    for category in ["brain"]:
        for subcat in structure[category].keys():
            sub_path = dataset_root / category / subcat
            if sub_path.exists():
                for f in sub_path.glob("*.nii*"):
                    structure[category][subcat].append({
                        "name": f.name,
                        "path": str(f),
                        "size_mb": round(f.stat().st_size / (1024 * 1024), 2)
                    })
                    
    return {
        "dataset_root": str(dataset_root.resolve()),
        "structure": structure,
        "summary": {
            "brain_total": sum(len(v) for v in structure["brain"].values()),
        }
    }

